# Easypanel connection
EASYPANEL_URL=http://localhost:3000
EASYPANEL_EMAIL=admin@example.com
EASYPANEL_PASSWORD=your-password

# Gateway config
PORT=3100
APP_URL=https://api.yourdomain.com

# External API auth (omit for dev mode — no auth required)
# API_SECRET=generate-a-strong-secret-here

# Read-only observability facade. Prefer a restricted Docker socket proxy in
# production; direct socket mounting grants the container host-level power.
OBSERVABILITY_ENABLED=true
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Preferred in production: point to a restricted docker-socket-proxy instead of mounting the socket here.
# DOCKER_API_URL=http://docker-socket-proxy:2375
OBSERVABILITY_SAMPLE_INTERVAL_SECONDS=60
OBSERVABILITY_MAX_POINTS=1440
